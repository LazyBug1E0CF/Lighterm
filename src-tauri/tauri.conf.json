{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lighterm",
  "version": "0.1.3",
  "identifier": "com.lighterm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lighterm",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 540,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#1a1b26",
        "additionalBrowserArgs": "--no-proxy-server --autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "category": "DeveloperTool",
    "homepage": "https://github.com/LazyBug1E0CF/Lighterm",
    "shortDescription": "Cross-platform lightweight GUI terminal and SSH/SFTP client",
    "longDescription": "Lighterm is a lightweight, cross-platform GUI terminal emulator and SSH/SFTP workbench built with Tauri v2, Rust, React, and xterm.js.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
